# Copy to .env. Database/signing values must remain private.
SUPABASE_URL=
SUPABASE_PUBLIC_KEY=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=
SUPABASE_DB_NAME=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSLMODE=require
DATABASE_URL=
# Private Supabase management token for Edge Function deployment; never a client key.
SUPABASE_ACCESS_TOKEN=
RELEASE_STORE_FILE=.engineering/signing/optics-release.keystore
RELEASE_KEY_ALIAS=optics
RELEASE_STORE_PASSWORD=
RELEASE_KEY_PASSWORD=

# Public release identity and pages (no secrets)
RELEASE_DEVELOPER_NAME=Saad Fareed
RELEASE_SUPPORT_EMAIL=pakistanbakeries@gmail.com
RELEASE_PRIVACY_URL=
RELEASE_ACCOUNT_DELETION_URL=

# Owned email delivery settings
# Owned email channel — server only; never embed these credentials in Android.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=pakistanbakeries@gmail.com
SMTP_PASSWORD=
# Brand used in auth emails (subjects, sender name, support line)
MAIL_BRAND_NAME=Raheel Optics
MAIL_FROM_ADDRESS=pakistanbakeries@gmail.com
MAIL_REPLY_TO=pakistanbakeries@gmail.com
SEND_EMAIL_HOOK_SECRET=
AUTH_EMAIL_PAGE_URL=
MAIL_WEBHOOK_PORT=8787

# Dedicated private directory (mode 0700), server only
MAIL_OUTBOX_PATH=backend/mail/runtime/outbox.sqlite

# Android crash reporting is Firebase Crashlytics: put app/google-services.json (git-ignored) from the Firebase console.
# Server-only DSN for the mail webhook's optional error signal (Sentry); a no-op when unset.
SENTRY_DSN_BACKEND=
