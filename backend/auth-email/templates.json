{
 "mailer_otp_length": 6,
 "mailer_otp_exp": 3600,
 "mailer_subjects_confirmation": "Your Raheel Optics code: {{ .Token }}",
 "mailer_templates_confirmation_content": "<!doctype html><html><body style=\"margin:0;background:#f4f6fa;font-family:Arial,Helvetica,sans-serif;color:#13263a\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding:32px 12px\"><tr><td align=\"center\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:480px;background:#ffffff;border-radius:16px;border:1px solid #e3e8ef\">\n<tr><td style=\"background:#123a6b;border-radius:16px 16px 0 0;padding:22px 28px;color:#ffffff;font-size:20px;font-weight:bold\">Raheel Optics</td></tr>\n<tr><td style=\"padding:28px\">\n<h1 style=\"margin:0 0 12px;font-size:22px\">Confirm your email</h1>\n<p style=\"margin:0 0 24px;font-size:15px;line-height:22px;color:#4a5a6c\">Enter this code in the Raheel Optics app to finish creating your account.</p>\n<div style=\"text-align:center;margin:0 0 24px\"><span style=\"display:inline-block;background:#eef3fb;border:1px dashed #123a6b;border-radius:12px;padding:16px 28px;font-size:34px;letter-spacing:10px;font-weight:bold;font-family:'Courier New',monospace;color:#123a6b\">{{ .Token }}</span></div>\n<p style=\"margin:0 0 8px;font-size:14px;color:#4a5a6c\">The code expires in 1 hour. Never share it with anyone, including shop staff.</p>\n<p style=\"margin:0;font-size:13px;color:#8593a3\">If you didn't create an account, you can ignore this email.</p>\n</td></tr>\n<tr><td style=\"padding:16px 28px;border-top:1px solid #e3e8ef;font-size:12px;color:#8593a3\">Raheel Optics \u00b7 Clear vision. Personal care.</td></tr>\n</table></td></tr></table></body></html>",
 "mailer_subjects_recovery": "Your Raheel Optics password reset code: {{ .Token }}",
 "mailer_templates_recovery_content": "<!doctype html><html><body style=\"margin:0;background:#f4f6fa;font-family:Arial,Helvetica,sans-serif;color:#13263a\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding:32px 12px\"><tr><td align=\"center\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:480px;background:#ffffff;border-radius:16px;border:1px solid #e3e8ef\">\n<tr><td style=\"background:#123a6b;border-radius:16px 16px 0 0;padding:22px 28px;color:#ffffff;font-size:20px;font-weight:bold\">Raheel Optics</td></tr>\n<tr><td style=\"padding:28px\">\n<h1 style=\"margin:0 0 12px;font-size:22px\">Reset your password</h1>\n<p style=\"margin:0 0 24px;font-size:15px;line-height:22px;color:#4a5a6c\">Enter this code in the Raheel Optics app, then choose a new password.</p>\n<div style=\"text-align:center;margin:0 0 24px\"><span style=\"display:inline-block;background:#eef3fb;border:1px dashed #123a6b;border-radius:12px;padding:16px 28px;font-size:34px;letter-spacing:10px;font-weight:bold;font-family:'Courier New',monospace;color:#123a6b\">{{ .Token }}</span></div>\n<p style=\"margin:0 0 8px;font-size:14px;color:#4a5a6c\">The code expires in 1 hour. Never share it with anyone, including shop staff.</p>\n<p style=\"margin:0;font-size:13px;color:#8593a3\">If you didn't ask to reset your password, you can ignore this email \u2014 your password stays the same.</p>\n</td></tr>\n<tr><td style=\"padding:16px 28px;border-top:1px solid #e3e8ef;font-size:12px;color:#8593a3\">Raheel Optics \u00b7 Clear vision. Personal care.</td></tr>\n</table></td></tr></table></body></html>",
 "mailer_subjects_magic_link": "Your Raheel Optics sign-in code: {{ .Token }}",
 "mailer_templates_magic_link_content": "<!doctype html><html><body style=\"margin:0;background:#f4f6fa;font-family:Arial,Helvetica,sans-serif;color:#13263a\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding:32px 12px\"><tr><td align=\"center\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:480px;background:#ffffff;border-radius:16px;border:1px solid #e3e8ef\">\n<tr><td style=\"background:#123a6b;border-radius:16px 16px 0 0;padding:22px 28px;color:#ffffff;font-size:20px;font-weight:bold\">Raheel Optics</td></tr>\n<tr><td style=\"padding:28px\">\n<h1 style=\"margin:0 0 12px;font-size:22px\">Your sign-in code</h1>\n<p style=\"margin:0 0 24px;font-size:15px;line-height:22px;color:#4a5a6c\">Enter this code in the Raheel Optics app to sign in.</p>\n<div style=\"text-align:center;margin:0 0 24px\"><span style=\"display:inline-block;background:#eef3fb;border:1px dashed #123a6b;border-radius:12px;padding:16px 28px;font-size:34px;letter-spacing:10px;font-weight:bold;font-family:'Courier New',monospace;color:#123a6b\">{{ .Token }}</span></div>\n<p style=\"margin:0 0 8px;font-size:14px;color:#4a5a6c\">The code expires in 1 hour. Never share it with anyone, including shop staff.</p>\n<p style=\"margin:0;font-size:13px;color:#8593a3\">If you didn't try to sign in, you can ignore this email.</p>\n</td></tr>\n<tr><td style=\"padding:16px 28px;border-top:1px solid #e3e8ef;font-size:12px;color:#8593a3\">Raheel Optics \u00b7 Clear vision. Personal care.</td></tr>\n</table></td></tr></table></body></html>"
}